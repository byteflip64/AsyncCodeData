       playerHealth.TakeDamage(damage);\n        \n        // Wait one frame for any coroutines or events to process\n        yield return null;\n        \n        // Assert - Use reflection to read private field, or better, expose via property\n        var healthField = playerHealth.GetType().GetField(\"currentHealth\",\n            System.Reflection.BindingFlags.NonPublic |\n            System.Reflection.BindingFlags.Instance);\n        int actualHealth = (int)healthField.GetValue(playerHealth);\n        \n        Assert.AreEqual(expectedHealth, actualHealth, \n            $\"Health should be {expectedHealth} after taking {damage} damage\");\n    }\n\n    [UnityTest]\n    public IEnumerator TakeDamage_BelowZero_TriggersDeathEvent()\n    {\n        // Arrange\n        bool deathEventFired = false;\n        playerHealth.OnDied += () => deathEventFired = true;\n        \n        // Act - Deal massive damage\n        playerHealth.TakeDamage(999);\n        yield return null;\n        \n        // Assert\n        Assert.IsTrue(deathEventFired, \"Death event should fire when health reaches 0\");\n        \n        // Verify isDead flag\n        var isDeadField = playerHealth.GetType().GetField(\"isDead\",\n            System.Reflection.BindingFlags.NonPublic |\n            System.Reflection.BindingFlags.Instance);\n        bool isDead = (bool)isDeadField.GetValue(playerHealth);\n        Assert.IsTrue(isDead, \"Player should be marked as dead\");\n    }\n\n    [UnityTest]\n    public IEnumerator InvulnerablePlayer_TakesNoDamage()\n    {\n        // Arrange\n        playerHealth.SetInvulnerable(true);\n        int initialHealth = 100;\n        \n        // Act\n        playerHealth.TakeDamage(50);\n        yield return null;\n        \n        // Assert\n        var healthField = playerHealth.GetType().GetField(\"currentHealth\",\n            System.Reflection.BindingFlags.NonPublic |\n            System.Reflection.BindingFlags.Instance);\n        int actualHealth = (int)healthField.GetValue(playerHealth);\n        \n        Assert.AreEqual(initialHealth, actualHealth,\n            \"Invulnerable player should take no damage\");\n    }\n\n    [UnityTest]\n    public IEnumerator Heal_ExceedsMaxHealth_ClampedToMax()\n    {\n        // Arrange - damage first, then overheal\n        playerHealth.TakeDamage(50);  // Health now 50\n        yield return null;\n        \n        // Act - heal more than the damage taken\n        playerHealth.Heal(100);  // Would take health to 150, should clamp to 100\n        yield return null;\n        \n        // Assert\n        var healthField = playerHealth.GetType().GetField(\"currentHealth\",\n            System.Reflection.BindingFlags.NonPublic |\n            System.Reflection.BindingFlags.Instance);\n        int actualHealth = (int)healthField.GetValue(playerHealth);\n        \n        Assert.AreEqual(100, actualHealth,\n            \"Healing should not exceed max health\");\n    }\n}",

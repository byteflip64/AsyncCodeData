                    "value": "// EDIT MODE TEST: Testing pure game logic without any scene or Play Mode\n// File: Assets/Tests/EditMode/DamageCalculatorTests.cs\n\nusing NUnit.Framework;\nusing UnityEngine;\n\n// Pure C# class — no MonoBehaviour, no Unity dependencies beyond Mathf\npublic class DamageCalculator\n{\n    public static int CalculateDamage(\n        int baseDamage,\n        float attackerStrength,\n        float defenderDefense,\n        bool isCriticalHit,\n        float criticalMultiplier)\n    {\n        float damage = baseDamage * (attackerStrength / defenderDefense);\n        \n        if (isCriticalHit)\n        {\n            damage *= criticalMultiplier;\n        }\n        \n        // Clamp to reasonable bounds\n        damage = Mathf.Clamp(damage, 1, 9999);\n        \n        return Mathf.RoundToInt(damage);\n    }\n    \n    public static bool IsCriticalHit(float luck, float threshold)\n    {\n        return luck >= threshold;\n    }\n}\n\n// Edit Mode Test Class\npublic class DamageCalculatorTests\n{\n    [Test]\n    public void CalculateDamage_NormalHit_ReturnsExpectedDamage()\n    {\n        // Arrange\n        int baseDamage = 50;\n        float attackerStrength = 10f;\n        float defenderDefense = 5f;\n        \n        // Act\n        int result = DamageCalculator.CalculateDamage(\n            baseDamage, attackerStrength, defenderDefense, false, 2.0f);\n        \n        // Assert\n        Assert.AreEqual(100, result, \"Normal hit should deal 100 damage (50 * 10/5)\");\n    }\n    \n    [Test]\n    public void CalculateDamage_CriticalHit_DoublesDamage()\n    {\n        // Arrange\n        int baseDamage = 50;\n        float attackerStrength = 10f;\n        float defenderDefense = 5f;\n        \n        // Act\n        int result = DamageCalculator.CalculateDamage(\n            baseDamage, attackerStrength, defenderDefense, true, 2.0f);\n        \n        // Assert\n        Assert.AreEqual(200, result, \"Critical hit with 2x multiplier should deal 200 damage\");\n    }\n    \n    [Test]\n    public void CalculateDamage_ZeroDefense_ClampedToMinimum()\n    {\n        // Arrange\n        int baseDamage = 50;\n        float attackerStrength = 10f;\n        float defenderDefense = 0f;  // Division by zero risk!\n        \n        // Act\n        int result = DamageCalculator.CalculateDamage(\n            baseDamage, attackerStrength, defenderDefense, false, 2.0f);\n        \n        // Assert - The calculator should handle this gracefully\n        Assert.GreaterOrEqual(result, 1, \"Damage should never be less than 1\");\n    }\n    \n    [Test]\n    public void IsCriticalHit_LuckAboveThreshold_ReturnsTrue()\n    {\n        // Arrange\n        float luck = 75f;\n        float threshold = 50f;\n        \n        // Act\n        bool result = DamageCalculator.IsCriticalHit(luck, threshold);\n        \n        // Assert\n        Assert.IsTrue(result, \"Luck of 75 should exceed threshold of 50\");\n    }\n    \n    [Test]\n    public void IsCriticalHit_LuckBelowThreshold_ReturnsFalse()\n    {\n        // Arrange\n        float luck = 30f;\n        float threshold = 50f;\n        \n        // Act\n        bool result = DamageCalculator.IsCriticalHit(luck, threshold);\n        \n        // Assert\n        Assert.IsFalse(result, \"Luck of 30 should not exceed threshold of 50\");\n    }\n    \n    [Test]\n    [TestCase(100, 10f, 5f, false, 2f, ExpectedResult = 200)]\n    [TestCase(100, 10f, 10f, false, 2f, ExpectedResult = 100)]\n    [TestCase(100, 10f, 20f, false, 2f, ExpectedResult = 50)]\n    [TestCase(100, 10f, 5f, true, 2f, ExpectedResult = 400)]\n    [TestCase(100, 10f, 5f, true, 3f, ExpectedResult = 600)]\n    public int CalculateDamage_ParameterizedTests(\n        int baseDamage, float strength, float defense, bool crit, float critMult)\n    {\n        return DamageCalculator.CalculateDamage(baseDamage, strength, defense, crit, critMult);\n    }\n}",
